.inspiration-page,.my-page{position:relative;padding:26rpx 28rpx calc(170rpx + env(safe-area-inset-bottom))}.page-subtitle{font-size:25rpx;line-height:1.6;color:var(--nikki-secondary);margin:12rpx 0 30rpx}.small-round-action{margin:0;width:72rpx;height:72rpx;line-height:70rpx;padding:0;border-radius:50%;font-size:36rpx;color:var(--nikki-accent);background:#fff9}.inspiration-heading{flex-wrap:nowrap;gap:18rpx}.inspiration-create,.my-inspiration{display:flex;align-items:center;gap:22rpx;min-height:130rpx;padding:24rpx;margin:0 0 16rpx;border-radius:30rpx;text-align:left;font-size:29rpx;color:var(--nikki-text)}.inspiration-create>view:nth-child(2),.my-inspiration>view:nth-child(2){flex:1;min-width:0}.create-symbol{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:23rpx;background:linear-gradient(145deg,#f7dde8,#fbe9dd);color:#9d647e;font-size:42rpx;flex-shrink:0}.card-caption{display:block;font-size:23rpx;color:var(--nikki-secondary);font-weight:400;line-height:1.65;margin-top:7rpx}.row-chevron{color:#a28b9a;font-size:36rpx}.inspiration-message{font-size:22rpx;color:var(--nikki-secondary);line-height:1.6;margin:16rpx 6rpx 24rpx}.inspiration-empty{padding:65rpx 14rpx;text-align:center;font-size:27rpx;color:var(--nikki-secondary)}.inspiration-empty>text{display:block;font-size:64rpx;color:#c98eab;margin-bottom:24rpx}
.inspiration-grid{gap:20rpx;align-items:start}.inspiration-card{padding:0;border-radius:30rpx;overflow:hidden;border:1rpx solid #fff9;box-shadow:0 7rpx 25rpx #6e506008}.inspiration-cover{height:360rpx;aspect-ratio:auto;border-radius:0;position:relative;background:linear-gradient(155deg,#f3edea,#f7eff3);color:#b38b9e}.inspiration-cover>text{font-size:26rpx}.inspiration-cover .reference-count{position:absolute;right:14rpx;bottom:14rpx;background:#ffffffb8;color:#725667;border-radius:18rpx;padding:4rpx 12rpx;font-size:20rpx}.inspiration-card-body{padding:19rpx}.inspiration-tags{display:flex;justify-content:space-between;gap:8rpx;color:#9d6f87;font-size:19rpx}.inspiration-tags text{padding:3rpx 9rpx;background:#f8eaf0;border-radius:10rpx;white-space:nowrap}.inspiration-title{font-size:28rpx;line-height:1.5;margin:14rpx 0 5rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.inspiration-code{font-size:22rpx;color:var(--nikki-secondary);line-height:1.5;max-height:66rpx;overflow:hidden;word-break:break-all}.inspiration-actions{gap:8rpx;flex-wrap:nowrap;margin-top:16rpx}.inspiration-card .inspiration-actions button{height:58rpx;box-sizing:border-box;line-height:58rpx;margin:0;padding:0 12rpx;border-radius:19rpx}.copy-code{flex:1;background:#f5e0e9;color:#84566c}.more-code{width:54rpx;background:#f5f0ef;color:#887781;font-size:20rpx!important}
.inspiration-editor-sheet{padding:22rpx 32rpx calc(24rpx + env(safe-area-inset-bottom))}.editor-scroll{max-height:65vh;height:65vh;margin-top:8rpx}.editor-section{padding:18rpx 0}.field-label{display:block;font-size:25rpx;font-weight:500;color:var(--nikki-text);margin:18rpx 0 12rpx}.editor-caption{font-size:23rpx;color:var(--nikki-secondary);line-height:1.65;margin:8rpx 0 18rpx}.form-input{height:88rpx;min-height:88rpx;line-height:normal;box-sizing:border-box;width:100%;padding:0 22rpx;background:#f7f2f3;border:1rpx solid #eee4e9;border-radius:22rpx;font-size:27rpx;color:var(--nikki-text)}.inspiration-field{height:84rpx;box-sizing:border-box;padding:0 22rpx;display:flex;align-items:center;justify-content:space-between;background:#f7f2f3;border:1rpx solid #eee4e9;border-radius:22rpx;font-size:26rpx;margin:14rpx 0}.inspiration-field>text{font-size:22rpx;color:#a48e9b}.inspiration-code-input{box-sizing:border-box;width:100%;height:176rpx;padding:20rpx 22rpx;font-size:27rpx;line-height:1.65;background:#f7f2f3;border-radius:22rpx;border:1rpx solid #eee4e9}.paste-action{font-size:24rpx;color:#965e78;background:#f6e5ed;margin:14rpx 0 0;padding:18rpx;border-radius:22rpx}.editor-footer{display:flex;gap:16rpx;padding-top:18rpx}.editor-footer button{flex:1;margin:0;padding:22rpx 12rpx;font-size:27rpx}
.profile-card{display:flex;align-items:center;gap:24rpx;padding:28rpx;border-radius:32rpx;margin-bottom:24rpx}.profile-avatar{width:100rpx;height:100rpx;display:flex;justify-content:center;align-items:center;border-radius:34rpx;background:linear-gradient(145deg,#efcedf,#fbe4d4);color:#9c5f7d;font-size:40rpx;flex-shrink:0}.profile-card-name{font-size:34rpx;font-weight:600;line-height:1.4;word-break:break-all}.my-section{padding:28rpx;border-radius:32rpx;margin-bottom:24rpx}.section-title{font-size:29rpx;font-weight:600}.my-section .primary-action{margin-top:24rpx;padding:22rpx;font-size:27rpx}.watermark-preview{background:linear-gradient(120deg,#ebd9df,#f4e4db);padding:24rpx;border-radius:22rpx;margin-top:26rpx;color:#785567}.watermark-preview text{display:block;font-size:27rpx;line-height:1.5;word-break:break-all}.watermark-preview text+text{font-size:22rpx;opacity:.8;margin-top:10rpx}.clear-profile{margin:16rpx 0 0;font-size:23rpx;background:transparent;color:#a18b98;padding:8rpx}.save-location-note{font-size:23rpx;line-height:1.75;color:var(--nikki-secondary);margin-top:22rpx}.my-section .save-preference{margin-top:20rpx}
.photo-info{height:66.666667vh;border-radius:38rpx 38rpx 0 0;background:rgba(255,252,247,.97);box-shadow:0 -10rpx 50rpx #21142218;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.info-handle-zone{padding:14rpx 0 16rpx}.info-heading{font-size:30rpx;line-height:44rpx;padding-bottom:10rpx}
.info-scroll{height:calc(40.666667vh - 208rpx - env(safe-area-inset-bottom))}.info-expanded .info-scroll{height:calc(66.666667vh - 208rpx - env(safe-area-inset-bottom))}
.info-note{font-size:21rpx;line-height:1.5;padding:12rpx 0 8rpx;color:#9a8994}.detail-section-title{font-size:25rpx;font-weight:600;margin:20rpx 0 12rpx}
.parameter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.parameter-grid .info-row{display:flex;flex-direction:column;gap:5rpx;padding:12rpx 14rpx;border-radius:18rpx;background:#f4f0ee;font-size:25rpx;line-height:1.4}.parameter-grid .info-row text:first-child{font-size:20rpx}.parameter-grid .info-row text:last-child{text-align:left;font-weight:500;overflow-wrap:anywhere}
.outfit-title{font-size:25rpx;font-weight:600;margin:4rpx 0 12rpx}.outfit-title>text{font-size:21rpx;font-weight:400;margin-left:10rpx;color:#9a8994}
.outfit-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx 10rpx}.outfit-card{display:flex;flex-direction:column;align-items:center;gap:6rpx;padding:8rpx 4rpx;border-radius:18rpx;background:transparent;min-width:0}
.outfit-picture{height:78rpx;width:78rpx;flex-shrink:0;overflow:hidden;border-radius:18rpx;background:#f0ebe8}.outfit-labels{width:100%;min-width:0;text-align:center}.outfit-name{font-size:22rpx;margin:0;line-height:1.35;word-break:break-all;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:60rpx}.outfit-placeholder{font-size:18rpx}.outfit-fallback{font-size:18rpx;line-height:1.3;margin-top:2rpx;color:#a995a1}
.share-entry{font-size:26rpx;line-height:1.3;padding:16rpx;background:#f2d7e4;margin:12rpx 0 0;border-radius:24rpx;color:#80566d}
.deletion-panel{margin:24rpx 0;padding:20rpx;border-radius:28rpx}.deletion-heading{background:transparent;text-align:left;font-size:26rpx;color:#755c71;padding:0;margin:0}.deletion-heading::after,.deletion-row button::after{border:0}.deletion-note{display:block;font-size:23rpx;line-height:1.6;color:#887a82}.deletion-row{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid #d7b8c52e}.deletion-row>view{flex:1;min-width:0}.deletion-label{font-size:26rpx;color:#655564}.deletion-row button,.dock-delete{font-size:24rpx;color:#a95771;background:#fff7fa99;border-radius:24rpx}.dock-delete{margin:0 12rpx;flex-shrink:0}.delete-action{color:#edb5c3!important}.viewer-deletion-note{display:block;font-size:22rpx;color:#ddd;line-height:1.5;width:100%}
