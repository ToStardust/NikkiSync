<wxs module="motion" src="./motion.wxs"></wxs>
<view class="ambient">
  <image wx:if="{{ambientPath}}" class="photo-atmosphere" src="{{ambientPath}}" mode="aspectFill"></image>
  <view class="atmosphere-wash"></view>
</view>
<view class="gallery" hidden="{{inspirationOpen || myOpen}}">
  <view class="gallery-header">
    <view class="heading-row">
      <text class="title album-title">{{albumTitle}}</text>
      <button class="connection-pill glass-surface" bindtap="openConnection" aria-label="查看连接状态">
        <view class="status-dot {{connected ? 'online' : ''}}"></view>{{busy ? '载入中' : connected ? '已连接' : '未连接'}} <text>›</text>
      </button>
    </view>
    <view wx:if="{{connected}}" class="header-caption">{{filterActive ? total + ' 张符合条件 · 图库 ' + libraryTotal + ' 张' : total + ' 张照片 · 来自你的电脑'}}</view>
    <button wx:if="{{resumeAvailable && !connected}}" class="refresh-entry" bindtap="resumeConnection" disabled="{{busy}}">{{busy ? '正在恢复连接…' : '重试连接 ↻'}}</button>
    <view wx:if="{{connected && browseEnabled}}" class="search-row">
      <input class="photo-search glass-surface" value="{{searchText}}" maxlength="80" placeholder="搜索服装、版本、日期" confirm-type="search" bindinput="searchChanged" bindconfirm="applyFilters" disabled="{{busy || saving}}" />
      <button class="filter-button {{filterActive ? 'filter-active' : ''}}" bindtap="toggleFilters" disabled="{{busy || saving}}">筛选</button>
    </view>
    <view wx:if="{{filtersOpen}}" class="filter-panel glass-surface">
      <picker range="{{versionOptions}}" range-key="label" value="{{versionIndex}}" bindchange="versionChanged"><view class="filter-field">版本 <text>{{versionOptions[versionIndex].label}}</text></view></picker>
      <view class="date-filters"><picker mode="date" value="{{filterFrom}}" bindchange="fromChanged"><view class="filter-field">{{filterFrom || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{filterTo}}" bindchange="toChanged"><view class="filter-field">{{filterTo || '结束日期'}}</view></picker></view>
      <view class="filter-actions"><button bindtap="clearFilters">清除</button><button bindtap="applyFilters">查看照片</button></view>
    </view>
    <button wx:if="{{connected && downloadEnabled}}" class="refresh-entry" bindtap="refreshPhotos" disabled="{{busy || saving || infoLoading || hdLoading || selectionMode}}">检查新照片 ↻</button>
    <view wx:if="{{photos.length || selectedCount || selectionMode}}" class="selection-bar">
      <block wx:if="{{selectionMode}}">
        <button bindtap="cancelSelection" disabled="{{saving}}">取消</button>
        <text>已选 {{selectedCount}} 张</text>
        <button bindtap="selectAll" disabled="{{busy || saving}}">全选本页</button>
      </block>
      <button wx:else class="select-entry" bindtap="startSelection" disabled="{{busy || saving}}">选择照片</button>
    </view>
  </view>
  <view wx:if="{{!photos.length}}" class="empty-card glass-surface">
    <view class="empty-camera" aria-hidden="{{true}}"><view></view></view>
    <view class="empty-title">{{busy ? (connected ? '正在读取电脑照片' : '正在连接电脑') : !connected ? '连接你的电脑' : filterActive ? '没有符合条件的照片' : '还没有照片'}}</view>
    <view class="empty-copy">{{busy ? '照片加载后会显示在这里' : !connected ? '在电脑端点击「微信下载照片」，然后扫码连接。' : filterActive ? '换个服装名称或日期试试' : '在无限暖暖里拍下第一张照片吧。'}}</view>
    <button wx:if="{{filterActive && !busy}}" class="secondary-action" bindtap="clearFilters">清除筛选</button>
    <button wx:if="{{!connected}}" class="primary-action" bindtap="scanPc" loading="{{busy}}" disabled="{{busy}}">扫码连接电脑</button>
  </view>
  <block wx:else>
    <view class="section-heading">
      <text class="date-summary">{{dateSummary}}</text>
      <text class="page-count">{{pageStart}}–{{pageEnd}} / {{total}}</text>
    </view>
    <view class="version-group" wx:for="{{groups}}" wx:for-item="group" wx:key="version">
      <view class="version-heading"><text>{{group.label}}</text><text>{{group.inferred ? '自动推测 · ' : ''}}本页 {{group.photos.length}} 张</text></view>
    <view class="grid">
      <view class="tile {{item.selected ? 'tile-selected' : ''}}" wx:for="{{group.photos}}" wx:key="id" bindtap="tileTapped" bindlongpress="longSelect" data-index="{{item.index}}" aria-label="{{item.path ? '预览 ' + item.date + ' 的照片' : item.state}}">
        <image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" style="transform:rotate({{item.rotation || 0}}deg)" binderror="imageFailed" data-index="{{item.index}}" />
        <view wx:else class="placeholder"><view class="placeholder-mark"></view><text>{{item.state}}</text></view>
        <view wx:if="{{selectionMode}}" class="selection-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view wx:if="{{item.live}}" class="live-badge">◉ LIVE</view>
        <button wx:if="{{selectionMode && (item.path || item.video)}}" class="peek-photo" catchtap="openPhoto" data-index="{{item.index}}">预览</button>
        <text wx:if="{{item.saveState}}" class="save-badge">{{item.saveState === 'saved' ? '已保存' : '未完成'}}</text>
      </view>
    </view>
    </view>
  </block>
  <view wx:if="{{message || (busy && photos.length)}}" class="gallery-message" aria-live="polite">{{busy && photos.length ? '正在载入预览 · ' + loaded + ' / ' + photos.length : message}}</view>
  <view wx:if="{{connectionDiagnostic}}" class="connection-diagnostic">连接诊断 {{connectionDiagnostic}}</view>
  <view class="pagination" wx:if="{{connected && photos.length}}">
    <button class="secondary-action" bindtap="previousPage" disabled="{{busy || saving || infoLoading || hdLoading || pageStart === 1}}">‹ 上一页</button>
    <button class="secondary-action" bindtap="nextPage" disabled="{{busy || saving || infoLoading || hdLoading || next === null}}">{{next === null ? '已经到底了' : '下一页 ›'}}</button>
  </view>
  <view class="save-message" aria-live="polite">{{saveMessage}}</view>
  <view wx:if="{{deletionItems.length || deletionMessage}}" class="deletion-panel glass-surface">
    <button class="deletion-heading" bindtap="toggleDeletionList">删除申请 · {{deletionItems.length}} 项 {{deletionOpen ? '⌃' : '⌄'}}</button>
    <view class="deletion-note" aria-live="polite">{{deletionMessage}}</view>
    <block wx:if="{{deletionOpen}}">
      <view class="deletion-row" wx:for="{{deletionItems}}" wx:key="id">
        <view><text class="deletion-label">{{item.label}}</text><text class="deletion-note">{{item.count}} 个关联文件 · {{item.message}}</text></view>
        <button wx:if="{{item.canCancel && connected}}" data-id="{{item.id}}" bindtap="cancelDeletion">取消申请</button>
      </view>
    </block>
  </view>
  <view class="save-controls">
    <button wx:if="{{saving}}" class="secondary-action" bindtap="stopSaving" disabled="{{saveStopping}}">{{saveStopping ? '正在停止…' : '处理完这张后停止'}}</button>
    <button wx:if="{{!saving && retryCount}}" class="secondary-action" bindtap="retryUnfinished" disabled="{{busy || infoLoading || hdLoading || !downloadEnabled || !connected}}">重试 {{retryCount}} 张未完成</button>
  </view>
  <button wx:if="{{permissionDenied}}" class="secondary-action" bindtap="openAlbumSettings">开启相册保存权限</button>
  <view wx:if="{{connected && !downloadEnabled && !busy}}" class="preview-label">保存照片需要更新电脑端</view>
</view>
<view class="glass-dock glass-surface">
 <block wx:if="{{selectionMode && !inspirationOpen && !myOpen}}">
  <button class="dock-action dock-save" bindtap="saveSelected" disabled="{{busy || saving || infoLoading || hdLoading || !downloadEnabled || !connected || !selectedCount}}" loading="{{saving}}">保存 {{selectedCount}} 张照片</button>
  <button wx:if="{{deletionEnabled}}" class="dock-action dock-delete" bindtap="requestSelectedDeletion" disabled="{{busy || saving || infoLoading || hdLoading || !connected || !selectedCount}}">申请删除</button>
 </block>
  <block wx:else>
    <button class="dock-item {{!inspirationOpen && !myOpen ? 'active' : ''}}" bindtap="openAlbum"><view class="album-icon"><view></view></view><text>相册</text></button>
    <button class="dock-item {{inspirationOpen ? 'active' : ''}}" bindtap="openInspiration"><view class="inspiration-icon">✧</view><text>灵感</text></button>
    <button class="dock-item {{myOpen ? 'active' : ''}}" bindtap="openMy"><view class="profile-icon"><view></view></view><text>我的</text></button>
  </block>
</view>
<page-container show="{{viewerOpen || connectionOpen}}" position="{{popupPosition}}" overlay="{{popupOverlay}}" round="{{popupRound}}" duration="{{popupDuration}}" close-on-slide-down="{{false}}" bindbeforeleave="popupLeaving" bindafterleave="popupLeft" custom-style="{{popupStyle}}">
  <view wx:if="{{popupMode === 'inspirationEditor'}}" class="inspiration-editor-sheet">
   <view class="sheet-grabber"></view>
   <view class="sheet-heading"><text>{{inspirationDraft.title ? '编辑灵感' : '记录灵感'}}</text><button class="sheet-close" bindtap="cancelInspirationEdit" disabled="{{inspirationBusy}}" aria-label="收起编辑">×</button></view>
   <scroll-view scroll-y="{{true}}" class="editor-scroll">
    <view class="editor-section"><text class="field-label">分享码</text><view class="editor-caption">把心动的搭配和染色留在这里</view>
     <picker range="{{['染色码','搭配码','待识别']}}" value="{{inspirationTypeIndex}}" bindchange="inspirationTypeChanged"><view class="inspiration-field">{{['染色码','搭配码','待识别'][inspirationTypeIndex]}}<text>切换 ›</text></view></picker>
     <textarea class="inspiration-code-input" value="{{inspirationDraft.code}}" data-field="code" bindinput="inspirationInput" maxlength="600" placeholder="粘贴分享码或玩家分享的文字" adjust-position="{{true}}" />
     <button class="paste-action" bindtap="pasteInspiration" disabled="{{inspirationBusy}}">粘贴并识别分享码</button>
    </view>
    <view class="editor-section"><text class="field-label">标题</text><input class="form-input" value="{{inspirationDraft.title}}" data-field="title" bindinput="inspirationInput" maxlength="100" placeholder="给这份灵感起个名字（选填）" /></view>
    <view class="editor-section"><text class="field-label">分类</text><input class="form-input" value="{{inspirationDraft.categories}}" data-field="categories" bindinput="inspirationInput" maxlength="120" placeholder="例如：日常、童话、舞台" />
     <picker range="{{inspirationStatusNames}}" value="{{inspirationStatusIndex}}" bindchange="inspirationStatusChanged"><view class="inspiration-field">{{inspirationStatusNames[inspirationStatusIndex]}}<text>状态 ›</text></view></picker>
    </view>
    <view class="editor-caption">保存后可在卡片的“更多”中添加参考图。</view><view class="inspiration-message">{{inspirationMessage}}</view>
   </scroll-view>
   <view class="editor-footer"><button class="secondary-action" bindtap="cancelInspirationEdit" disabled="{{inspirationBusy}}">取消</button><button class="primary-action" bindtap="saveInspiration" disabled="{{inspirationBusy}}" loading="{{inspirationBusy}}">保存灵感</button></view>
  </view>
  <view wx:if="{{popupMode === 'connection'}}" class="connection-sheet">
    <view class="sheet-grabber"></view>
    <view class="sheet-heading"><text>我的电脑</text><button class="sheet-close" bindtap="closeConnection" aria-label="关闭连接面板">×</button></view>
    <view class="connection-card glass-surface">
      <view class="sheet-state"><view class="status-dot {{connected ? 'online' : ''}}"></view>{{busy ? '正在连接' : connected ? '电脑已连接' : '等待连接'}}</view>
      <view class="sheet-caption">{{connected ? total + ' 张照片' : '手机与电脑需连接同一 Wi-Fi'}}</view>
    </view>
    <view wx:if="{{message}}" class="sheet-message">{{message}}</view>
    <view wx:if="{{connectionDiagnostic}}" class="connection-diagnostic">连接诊断 {{connectionDiagnostic}}</view>
    <button class="primary-action" bindtap="scanPc" disabled="{{busy || saving || infoLoading || hdLoading}}" loading="{{busy}}">{{connected ? '重新扫码' : '扫码连接电脑'}}</button>
    <view class="privacy-copy">请勿转发连接二维码。连接码过期后，请在电脑重新生成。</view>
  </view>
  <view wx:if="{{popupMode === 'viewer'}}" class="viewer {{reduceMotion ? 'reduce-motion' : ''}}" bindtap="toggleViewerChrome">
    <view class="viewer-backdrop" data-frame="{{viewerFrames[0].key}}"></view>
    <block wx:for="{{viewerFrames}}" wx:key="key">
      <view class="photo-stage" data-frame="{{item.key}}" data-blocked="{{busy || saving || infoLoading || infoOpen || viewerClosing}}" motion="{{ {frame:item.key, phase:viewerPhase, settle:viewerSettle, reduced:reduceMotion, initialScale:item.initialScale} }}" change:motion="{{motion.photoState}}">
      <view class="photo-viewport" data-frame="{{item.key}}">
      <movable-area class="zoom-area" data-frame="{{item.key}}" data-image="{{true}}" data-reduced="{{reduceMotion}}" scale-area="{{true}}" catchtap="viewerPhotoTap" bindtouchstart="{{motion.photoStart}}" bindtouchmove="{{motion.photoMove}}" bindtouchend="{{motion.photoEnd}}" bindtouchcancel="{{motion.photoEnd}}">
        <movable-view class="zoom-image" data-frame="{{item.key}}" direction="all" scale="{{true}}" scale-min="{{1}}" scale-max="{{6}}" scale-value="{{item.initialScale}}" bindscale="{{motion.photoScale}}" x="{{0}}" y="{{0}}" animation="{{false}}">
          <view class="rotation-stage" style="width:{{rotationWidth}}px;height:{{rotationHeight}}px;transform:translate3d(-50%,-50%,0) rotate({{viewerRotation}}deg)">
          <image wx:if="{{viewerPreviewPath}}" src="{{viewerPreviewPath}}" data-frame="{{item.key}}" data-path="{{viewerPreviewPath}}" mode="aspectFit" bindload="viewerImageLoaded" />
          <image wx:if="{{viewerOriginalPath}}" class="original-layer {{originalReady ? 'ready' : ''}}" src="{{viewerOriginalPath}}" data-path="{{viewerOriginalPath}}" mode="aspectFit" bindload="originalLoaded" binderror="originalFailed" />
          </view>
        </movable-view>
      </movable-area>
      </view>
      </view>
    </block>
    <video wx:if="{{livePlaying && livePath}}" id="live-player" class="live-player" src="{{livePath}}" data-path="{{livePath}}" poster="{{viewerPreviewPath}}" object-fit="contain" autoplay="{{true}}" controls="{{true}}" show-fullscreen-btn="{{false}}" binderror="livePlaybackFailed" catchtap="swallowTap" />
    <view wx:if="{{!viewerPreviewPath}}" class="viewer-loading">{{busy ? '正在载入照片…' : '这张照片暂时不可用，可继续切换。'}}</view>
    <view class="viewer-chrome" data-frame="{{viewerFrames[0].key}}">
    <view wx:if="{{viewerChrome}}" class="viewer-toolbar">
      <button class="viewer-back" catchtap="dismissPhoto" aria-label="返回相册">‹</button>
      <view class="viewer-title"><text>{{selectedDate}}</text><text class="viewer-subtitle">{{viewerPosition}} / {{total}}</text></view>
    </view>
    <view wx:if="{{viewerChrome}}" class="viewer-actions" catchtap="swallowTap">
      <view class="viewer-navigation">
        <button bindtap="previousPhoto" disabled="{{busy || saving || infoLoading || infoOpen || viewerPosition <= 1}}" aria-label="上一张照片">‹</button>
        <button wx:if="{{selectionMode}}" bindtap="toggleViewedSelection" disabled="{{busy || saving}}">{{viewerSelected ? '✓ 已选中' : '选择这张'}}</button>
        <button bindtap="nextPhoto" disabled="{{busy || saving || infoLoading || infoOpen || viewerPosition >= total}}" aria-label="下一张照片">›</button>
      </view>
      <button wx:if="{{viewerLive}}" bindtap="playLive" disabled="{{busy || saving || infoLoading || hdLoading || !downloadEnabled || !connected}}">{{livePlaying ? (viewerVideo ? '停止播放' : '返回封面') : viewerVideo ? '播放视频' : '播放动态视频'}}</button>
      <view class="viewer-dock">
        <button bindtap="rotatePhoto" disabled="{{busy || saving || infoLoading || hdLoading || infoOpen || !exportEnabled}}" aria-label="顺时针旋转九十度">旋转</button>
        <button class="viewer-save" bindtap="saveViewed" disabled="{{busy || saving || infoLoading || hdLoading || !downloadEnabled || !connected}}" loading="{{saving}}">保存</button>
        <button bindtap="generateShareCard" disabled="{{viewerVideo || busy || saving || infoLoading || hdLoading || !downloadEnabled || !connected}}">分享</button>
        <button bindtap="showPhotoInfo" disabled="{{viewerVideo || infoLoading || hdLoading}}">详情</button>
      </view>
      <button wx:if="{{deletionEnabled && !viewerDeletionId}}" class="delete-action" bindtap="requestViewedDeletion" disabled="{{busy || saving || infoLoading || hdLoading || !connected}}">申请删除</button>
      <button wx:if="{{viewerDeletionId && connected}}" data-id="{{viewerDeletionId}}" bindtap="cancelDeletion" disabled="{{busy || saving}}">取消这张的删除申请</button>
      <text wx:if="{{deletionMessage}}" class="viewer-deletion-note" aria-live="polite">{{deletionMessage}}</text>
      <button wx:if="{{viewerRotation}}" bindtap="restoreRotation" disabled="{{busy || saving || infoLoading || hdLoading || infoOpen}}">还原</button>
      <button wx:if="{{saving}}" bindtap="stopSaving" disabled="{{saveStopping}}">{{saveStopping ? '正在停止…' : '停止保存'}}</button>
      <button wx:if="{{!saving && retryCount}}" bindtap="retryUnfinished" disabled="{{busy || infoLoading || hdLoading || !downloadEnabled || !connected}}">重试 {{retryCount}} 张</button>
      <view wx:if="{{saving || saveMessage}}" class="viewer-save-message">{{saveMessage}}</view>
      <view class="zoom-hint">{{hdLoading ? '正在加载高清原图…' : hdMessage || '左右切图 · 双击放大 · 下拉返回'}}</view>
    </view>
    </view>
    <view wx:if="{{infoMounted}}" class="info-backdrop" data-frame="{{viewerFrames[0].key}}" catchtap="closeInfo" catchtouchmove="swallowTap"></view>
    <view wx:if="{{infoMounted}}" class="photo-info glass-surface {{infoExpanded ? 'info-expanded' : ''}}" data-frame="{{viewerFrames[0].key}}" data-info-frame="{{infoFrame}}" data-open="{{infoOpen}}" motion="{{ {frame:viewerFrames[0].key, key:infoFrame, phase:infoPhase, expanded:infoExpanded, settle:infoSettle, reduced:reduceMotion, height:windowHeight, width:windowWidth, imageWidth:viewerImageWidth, imageHeight:viewerImageHeight, rotation:viewerRotation} }}" change:motion="{{motion.sheetState}}" catchtap="swallowTap">
      <view class="info-handle-zone" catchtouchstart="{{motion.sheetStart}}" catchtouchmove="{{motion.sheetMove}}" catchtouchend="{{motion.sheetEnd}}" catchtouchcancel="{{motion.sheetEnd}}" catchtap="toggleInfoSize" data-frame="{{viewerFrames[0].key}}" data-info-frame="{{infoFrame}}" data-expanded="{{infoExpanded}}" data-reduced="{{reduceMotion}}" data-height="{{windowHeight}}" aria-label="上拉展开参数，下拉收起"><view class="sheet-grabber"></view></view>
      <view class="info-heading"><text>穿搭与参数</text><view class="info-header-actions"><button bindtap="toggleInfoSize">{{infoExpanded ? '收起' : '展开'}}</button><button bindtap="closeInfo" aria-label="关闭参数">×</button></view></view>
      <scroll-view scroll-y="{{true}}" class="info-scroll">
        <view wx:if="{{outfitItems.length}}" class="outfit-title">本次穿搭 <text>{{outfitTotal}} 件</text></view>
        <view class="outfit-grid">
          <view wx:for="{{outfitItems}}" wx:key="key" class="outfit-card">
            <view class="outfit-picture">
              <image wx:if="{{item.iconPath}}" class="outfit-icon" src="{{item.iconPath}}" mode="aspectFit" data-key="{{item.key}}" data-path="{{item.iconPath}}" binderror="outfitIconFailed" />
              <view wx:else class="outfit-placeholder">{{item.iconState}}</view>
            </view>
            <view class="outfit-labels"><view class="outfit-name">{{item.name}}</view><view wx:if="{{item.iconSource === 'category'}}" class="outfit-fallback">分类示意</view></view>
          </view>
        </view>
        <view wx:if="{{outfitNote}}" class="info-note">{{outfitNote}}</view>
        <view wx:if="{{!outfitItems.length}}"><view class="info-row" wx:for="{{infoRows}}" wx:key="label" wx:if="{{item.label === '服装' || item.label === '服装名称'}}"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
        <view wx:if="{{infoRows.length}}" class="detail-section-title">拍摄参数</view>
        <view class="parameter-grid"><view class="info-row" wx:for="{{infoRows}}" wx:key="label" wx:if="{{item.label !== '服装' && item.label !== '服装名称'}}"><text>{{item.label}}</text><text>{{item.value}}{{item.label === '焦距' ? ' mm' : ''}}</text></view></view>
        <view class="info-note">{{selectedDate}} · {{infoMessage}}</view>
      </scroll-view>
      <button class="share-entry" bindtap="generateShareCard" disabled="{{viewerVideo || busy || saving || infoLoading || hdLoading || !downloadEnabled || !connected}}">生成分享图</button>
    </view>
    <view wx:if="{{shareOpen}}" class="share-overlay" catchtap="swallowTap" catchtouchmove="swallowTap">
      <view class="share-heading"><text>穿搭与参数分享图</text><button bindtap="closeShareCard" disabled="{{shareSaving}}" aria-label="关闭分享图">×</button></view>
      <scroll-view scroll-y="{{true}}" class="share-preview {{sharePreviewHeight ? 'share-preview-sized' : ''}}" style="{{sharePreviewHeight ? 'height:' + sharePreviewHeight + 'px' : ''}}">
        <image wx:if="{{sharePath}}" src="{{sharePath}}" mode="widthFix" class="share-preview-image" data-path="{{sharePath}}" bindload="sharePreviewLoaded" />
        <view wx:else class="share-placeholder">{{shareMessage}}</view>
      </scroll-view>
      <view class="share-status">{{shareMessage}}</view>
      <view wx:if="{{shareCount > 1}}" class="share-pagination"><button bindtap="previousShareCard" disabled="{{shareSaving || shareIndex === 0}}">上一张</button><text>{{shareIndex + 1}} / {{shareCount}}</text><button bindtap="nextShareCard" disabled="{{shareSaving || shareIndex + 1 >= shareCount}}">下一张</button></view>
      <view wx:if="{{sharePath}}" class="share-actions">
        <button class="share-save share-save-single" bindtap="saveGeneratedShareCard" disabled="{{shareBusy || shareSaving}}"><text class="share-action-label">保存分享图</text></button>
        <button class="share-save" bindtap="saveOriginalAndShareCard" disabled="{{shareBusy || shareSaving || !connected}}"><text class="share-action-label">保存原图和分享图</text></button>
      </view>
      <button wx:if="{{!shareBusy && !sharePath}}" bindtap="generateShareCard">重新生成</button>
      <button wx:if="{{permissionDenied && !shareSaving}}" bindtap="openAlbumSettings">打开相册权限设置</button>
    </view>
    <canvas type="2d" id="share-card-canvas" class="share-render-canvas" />
  </view>
</page-container>
<view wx:if="{{inspirationOpen}}" class="inspiration-page">
 <view class="inspiration-heading"><text class="title">穿搭灵感</text><button class="small-round-action" bindtap="refreshInspiration" disabled="{{inspirationBusy}}" aria-label="刷新灵感库">↻</button></view>
 <view class="page-subtitle">收藏心动搭配，留待下一次相遇</view>
 <button class="inspiration-create glass-surface" bindtap="editInspiration" disabled="{{inspirationBusy}}"><view class="create-symbol">＋</view><view><text>记录一份新灵感</text><text class="card-caption">搭配码 · 染色码 · 参考图片</text></view><text class="row-chevron">›</text></button>
 <view class="inspiration-message" aria-live="polite">{{inspirationMessage}}</view>
 <view wx:if="{{!inspirationItems.length && !inspirationBusy}}" class="inspiration-empty"><text>✧</text><view>你的下一套搭配，从这里开始</view><view class="card-caption">收藏分享码，再添加参考图</view></view>
 <view class="inspiration-grid">
  <view wx:for="{{inspirationItems}}" wx:key="id" class="inspiration-card glass-surface">
   <view class="inspiration-cover" bindtap="viewInspirationImage" data-id="{{item.id}}">
    <image wx:if="{{item.coverPath}}" src="{{item.coverPath}}" mode="aspectFit"/><text wx:else>{{item.images.length ? '点击查看参考图' : '✧'}}</text><text wx:if="{{item.images.length > 1}}" class="reference-count">{{item.images.length}} 张</text>
   </view>
   <view class="inspiration-card-body"><view class="inspiration-tags"><text>{{item.type === 'dye' ? '染色' : '搭配'}}</text><text>{{item.statusLabel}}</text></view><view class="inspiration-title">{{item.title || '未命名灵感'}}</view><view class="inspiration-code">{{item.code}}</view>
   <view class="inspiration-actions"><button class="copy-code" bindtap="copyInspiration" data-id="{{item.id}}" disabled="{{!item.code}}">复制分享码</button><button class="more-code" bindtap="inspirationOptions" data-id="{{item.id}}" disabled="{{inspirationBusy}}" aria-label="管理这条灵感">•••</button></view></view>
  </view>
 </view>
 <button wx:if="{{inspirationNext}}" class="secondary-action" bindtap="moreInspiration" disabled="{{inspirationBusy}}">下一页灵感</button>
</view>
<view wx:if="{{myOpen}}" class="my-page">
 <view class="heading-row"><text class="title">我的</text><button class="connection-pill glass-surface" bindtap="openConnection"><view class="status-dot {{connected ? 'online' : ''}}"></view>{{connected ? '电脑已连接' : '连接电脑'}} ›</button></view>
 <view class="page-subtitle">让每一张分享都有你的名字</view>
 <view class="profile-card glass-surface"><view class="profile-avatar">{{profileInitial || '喵'}}</view><view><view class="profile-card-name">{{profileSavedName || '搭配师'}}</view><view class="card-caption">{{profileSavedUid ? 'UID ' + profileSavedUid : '填写你的摄影名片'}}</view></view></view>
 <view class="my-section glass-surface"><view class="section-title">摄影名片</view><view class="card-caption">用于这台手机的分享图署名</view>
  <text class="field-label">昵称</text><input class="form-input" value="{{profileName}}" data-field="profileName" bindinput="profileInput" maxlength="32" placeholder="游戏内的名字" />
  <text class="field-label">游戏 UID</text><input class="form-input" type="number" value="{{profileUid}}" data-field="profileUid" bindinput="profileInput" maxlength="20" placeholder="填写你的游戏 UID（选填）" />
  <view class="watermark-preview"><text>{{profileTitle}}</text><text>{{profileFooter}}</text></view>
  <button class="primary-action" bindtap="saveProfile">保存名片</button><button wx:if="{{profileSavedUid || profileSavedName}}" class="clear-profile" bindtap="clearProfile">清除名片</button><view wx:if="{{profileMessage}}" class="card-caption" aria-live="polite">{{profileMessage}}</view>
 </view>
 <button class="my-inspiration glass-surface" bindtap="openInspiration" disabled="{{!connected || busy || saving}}"><view class="create-symbol">✧</view><view><text>穿搭灵感库</text><text class="card-caption">收藏搭配、染色与参考图</text></view><text class="row-chevron">›</text></button>
 <view class="my-section glass-surface"><view class="section-title">保存到相册</view><view class="save-preference"><view><text>附带拍摄参数</text><text class="preference-caption">保留游戏参数与原始拍摄时间</text></view><switch checked="{{writeExif}}" bindchange="toggleExif" disabled="{{saving}}" color="#D780AA" /></view>
  <view class="preference-caption">仅 JPEG 照片支持附带参数</view>
  <view class="save-location-note">保存位置由微信和手机系统管理，暂不支持选择文件夹。照片可能按拍摄时间归档，可在系统相册的“最近添加”中查看。</view>
 </view>
 <view class="my-section glass-surface"><view class="section-title">显示设置</view><view class="save-preference"><view><text>减少动态效果</text></view><switch checked="{{reduceMotion}}" bindchange="toggleReducedMotion" color="#D780AA" /></view></view>
</view>
