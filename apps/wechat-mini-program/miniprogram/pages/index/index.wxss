.intro { padding: 80rpx 40rpx; }
text { display: block; line-height: 1.7; }
.title { font-size: 48rpx; font-weight: 600; }
.subtitle { margin-top: 12rpx; font-size: 26rpx; color: #62776c; }
.notice { margin-top: 48rpx; padding: 32rpx; border-radius: 28rpx; background: #ffffff; }
.heading { margin-bottom: 16rpx; font-size: 32rpx; font-weight: 600; }
.notice text + text { margin-top: 16rpx; }
.scan { margin-top: 36rpx; background: #335b4e; color: #fff; border-radius: 24rpx; font-size: 30rpx; }
.status { margin-top: 24rpx; font-size: 26rpx; color: #62776c; word-break: break-all; }
