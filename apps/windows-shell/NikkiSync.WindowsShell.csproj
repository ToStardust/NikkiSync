<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.11</Version>
    <DesktopBuild Condition="'$(DesktopBuild)' == ''">2026102102</DesktopBuild>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DesktopBuild" Value="$(DesktopBuild)" />
    <EmbeddedResource Include="Assets\update-public-key.pem" LogicalName="MomoCamera.UpdatePublicKey" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="..\..\assets\branding\momo-camera.png" Link="Assets\brand.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup Condition="'$(PortablePayloadDirectory)' != ''">
    <EmbeddedResource Include="$(PortablePayloadDirectory)\runtime.zip" LogicalName="NikkiSync.Runtime.zip" />
    <EmbeddedResource Include="$(PortablePayloadDirectory)\runtime.json" LogicalName="NikkiSync.Runtime.json" />
  </ItemGroup>
</Project>
