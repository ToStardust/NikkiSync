<Window x:Class="NikkiSync.WindowsShell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="大喵相机助手 · NikkiSync PC" Icon="Assets/app.ico" Width="1020" Height="780" MinWidth="600" MinHeight="600" Background="#FFF8F0" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border x:Name="NativeRecoveryPanel" DockPanel.Dock="Bottom" Background="#FFFFFAFC" BorderBrush="#FFEADDE4" BorderThickness="0,1,0,0" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="NativeBuildText" FontSize="11" Foreground="#FF8F7E88" TextWrapping="Wrap"/>
          <TextBlock x:Name="NativeRecoveryStatus" Text="启动完成后可重启服务；随时可导出诊断。" FontSize="12" Foreground="#FF664F5E" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="NativeRestartButton" Grid.Column="1" Content="重启同步服务" Click="OnNativeRestartClick" Padding="12,7" Margin="0,0,8,0" VerticalAlignment="Center" Background="#FFF9E5EB" Foreground="#FF664F5E" BorderBrush="#FFE4CBD7"/>
        <Button x:Name="NativeExportButton" Grid.Column="2" Content="导出诊断包" Click="OnNativeExportClick" Padding="12,7" VerticalAlignment="Center" Background="#FFFFFAFC" Foreground="#FF664F5E" BorderBrush="#FFE4CBD7"/>
      </Grid>
    </Border>
    <ContentControl x:Name="MainSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid>
    <wv2:WebView2 x:Name="ControlPage" Visibility="Collapsed" />
    <Border x:Name="StartupPanel">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFF8F0" Offset="0" />
          <GradientStop Color="#F9E5EB" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Image Source="Assets/brand.png" Width="72" Height="72" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="大喵相机助手" FontSize="24" FontWeight="SemiBold" Foreground="#59475E" HorizontalAlignment="Center" />
        <TextBlock Text="把暖暖的美好，留在相册里" Margin="0,10,0,28" FontSize="14" Foreground="#8F7E88" HorizontalAlignment="Center" />
        <TextBlock x:Name="StartupText" Text="正在准备启动…" Margin="0,0,0,14" FontSize="15" Foreground="#664F5E" TextWrapping="Wrap" HorizontalAlignment="Center" />
        <ProgressBar x:Name="StartupProgress" Height="6" Minimum="0" Maximum="100" Background="#EDDEE3" Foreground="#F6BCC0" BorderThickness="0" IsIndeterminate="True" />
        <TextBlock x:Name="StartupElapsed" Text="已等待 0 秒" Margin="0,12,0,0" Foreground="#8F7E88" HorizontalAlignment="Center" />
        <TextBlock Text="首次启动或更新会准备运行文件，之后自动复用。" Margin="0,20,0,0" FontSize="12" Foreground="#8F7E88" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid></ContentControl></DockPanel>
</Window>
